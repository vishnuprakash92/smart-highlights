{
  "manifest_version": 3,
  "name": "Smart Highlights",
  "version": "0.1.0",
  "description": "Highlight-first AI analysis for web pages",
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Smart Highlights"
  },
  "permissions": ["storage", "contextMenus", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/service-worker/index.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content-script/bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
